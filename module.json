{
  "id": "jenne-asset-manager",
  "title": "Jenne Asset Manager",
  "description": "Universal asset orchestrator, batch importer, and deduplication engine for Foundry VTT. Unifies Beneos Battlemaps & Codex, D&D Beyond Importer, and local disk assets with deterministic cyrb53 tracking.",
  "version": "1.0.0",
  "authors": [
    {
      "name": "John Jenne & Antigravity"
    }
  ],
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "esmodules": [
    "scripts/init.mjs"
  ],
  "styles": [
    "css/asset-manager.css"
  ],
  "relationships": {
    "requires": [
      {
        "id": "jenne-suite",
        "type": "module"
      }
    ],
    "flags": {
      "beneos-module": {
        "title": "Beneos Module & Cloud",
        "optional": true
      },
      "ddb-importer": {
        "title": "D&D Beyond Importer",
        "optional": true
      },
      "monks-active-tiles": {
        "title": "Monk's Active Tile Triggers",
        "optional": true
      }
    }
  },
  "flags": {
    "hotReload": {
      "extensions": ["css", "hbs", "html", "json"],
      "paths": ["css/", "templates/"]
    }
  }
}
