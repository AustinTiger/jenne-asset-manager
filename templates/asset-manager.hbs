<div class="jenne-container">
  {{#if isScanning}}
    <div class="jenne-loading-container">
      <div class="jenne-spinner"></div>
      <p class="jenne-loading-text"><i class="fas fa-hourglass-half"></i> Indexing asset database. Please wait...</p>
    </div>
  {{else}}
    <!-- Left Sidebar (Configuration & Action Panel) -->
    <aside class="jenne-sidebar">
      <div class="jenne-sidebar-header">
        <h3><i class="fas fa-sliders-h"></i> Control Panel</h3>
        <button class="jenne-btn-icon" data-action="openSettings" title="Open Settings">
          <i class="fas fa-cog"></i>
        </button>
      </div>
      
      <!-- Top Section: Library & View Controls -->
      <div class="jenne-publisher-list" style="padding: 14px 16px; display: flex; flex-direction: column; gap: 14px; overflow-y: auto;">
        <!-- Content Source Selector -->
        <div class="toolbar-section flex-col">
          <label for="source-picker"><i class="fas fa-plug"></i> Content Source:</label>
          <select class="jenne-compendium-select" id="source-picker" style="width: 100%;">
            <option value="all" {{#if (eq activeSource "all")}}selected{{/if}}>All Sources</option>
            {{#if hasBeneos}}
              <option value="beneos" {{#if (eq activeSource "beneos")}}selected{{/if}}>🐉 Beneos</option>
            {{/if}}
            {{#if hasDdb}}
              <option value="ddb" {{#if (eq activeSource "ddb")}}selected{{/if}}>🎲 D&D Beyond</option>
            {{/if}}
            <option value="local" {{#if (eq activeSource "local")}}selected{{/if}}>📁 Local Drive</option>
          </select>
        </div>

        <!-- Columns count selector -->
        <div class="toolbar-section flex-col">
          <label for="column-picker"><i class="fas fa-th"></i> Grid Layout:</label>
          <select class="jenne-compendium-select" id="column-picker" style="width: 100%;">
            {{#each columnOptions}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>

        <!-- Module Tools & Library Actions -->
        <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 2px; padding-top: 10px; border-top: 1px solid rgba(212, 168, 87, 0.12);">
          <!-- Catalog Scan / Refresh -->
          <button class="jenne-btn btn-secondary" data-action="scan" style="width: 100%; display: flex; justify-content: center; align-items: center; gap: 8px; height: 32px; font-size: 11.5px;">
            <i class="fas fa-sync-alt"></i> Re-Scan Library
          </button>

          <!-- Beneos Batch Importer -->
          <button class="jenne-btn btn-secondary" data-action="openBeneosImporter" style="width: 100%; display: flex; justify-content: center; align-items: center; gap: 8px; height: 32px; font-size: 11.5px;">
            <i class="fas fa-file-import"></i> Beneos Importer
          </button>
        </div>
      </div>

      <!-- Action Panel at the bottom of the left sidebar (Context-Aware) -->
      <div class="jenne-batch-action-panel">
        <div class="batch-action-header">
          <label for="jenne-batch-action-select" class="batch-action-label">
            <i class="fas fa-bolt"></i> Batch Action:
          </label>
        </div>
        
        <!-- Action Dropdown -->
        <select class="jenne-compendium-select" id="jenne-batch-action-select" style="width: 100%; font-size: 12px; height: 34px;">
          <option value="import-compendium" {{#if (eq selectedBatchAction "import-compendium")}}selected{{/if}}>📦 Import to Compendium</option>
          {{#if hasBeneos}}
            <option value="beneos-install" {{#if (eq selectedBatchAction "beneos-install")}}selected{{/if}}>📥 Download / Install (Beneos)</option>
            <option value="beneos-update" {{#if (eq selectedBatchAction "beneos-update")}}selected{{/if}}>🔄 Update (Beneos)</option>
            <option value="beneos-uninstall" {{#if (eq selectedBatchAction "beneos-uninstall")}}selected{{/if}}>🗑️ Uninstall (Beneos)</option>
          {{/if}}
        </select>

        <!-- Action-Specific Options (Visible only when matching action is selected) -->
        {{#if (eq selectedBatchAction "import-compendium")}}
          <div class="jenne-action-specific-options">
            <!-- Target Compendium Selection -->
            <div class="toolbar-section flex-col">
              <label for="compendium-target" style="font-size: 10.5px;"><i class="fas fa-database"></i> Target Compendium:</label>
              <select class="jenne-compendium-select" id="compendium-target" style="width: 100%; font-size: 11.5px; height: 30px;">
                <option value="">-- Choose Target Pack --</option>
                {{#each compendiums}}
                  <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
            </div>
            
            <!-- Subfolder input -->
            <div class="toolbar-section flex-col">
              <label for="folder-target" style="font-size: 10.5px;"><i class="fas fa-folder-plus"></i> Subfolder (Optional):</label>
              <input type="text" class="jenne-folder-input" id="folder-target" placeholder="e.g. Monsters/Goblins" value="{{subfolder}}" style="width: 100%; font-size: 11.5px; height: 30px;">
            </div>
          </div>
        {{else if (eq selectedBatchAction "beneos-install")}}
          <div class="jenne-action-specific-options">
            <div class="action-info-box">
              <i class="fas fa-info-circle"></i>
              <span>Downloads and installs selected creature tokens and actor documents.</span>
            </div>
          </div>
        {{else if (eq selectedBatchAction "beneos-update")}}
          <div class="jenne-action-specific-options">
            <div class="action-info-box">
              <i class="fas fa-sync"></i>
              <span>Re-imports and updates selected creatures to the latest cloud version.</span>
            </div>
          </div>
        {{else if (eq selectedBatchAction "beneos-uninstall")}}
          <div class="jenne-action-specific-options">
            <div class="action-warning-box">
              <i class="fas fa-exclamation-triangle"></i>
              <span>Permanently deletes world Actor documents for selected creatures.</span>
            </div>
          </div>
        {{/if}}

        <!-- Primary Execute Button -->
        <button class="jenne-btn btn-primary {{#unless anySelected}}disabled{{/unless}}" 
                data-action="triggerBatchAction" 
                {{#unless anySelected}}disabled{{/unless}} 
                style="width: 100%; height: 38px; display: flex; justify-content: center; align-items: center; gap: 8px; font-weight: bold; font-size: 12.5px; margin-top: 2px;">
          <i class="fas fa-play"></i> Execute Action ({{selectedCount}})
        </button>
      </div>
    </aside>

    <!-- Main Content Display -->
    <main class="jenne-main">
      <!-- Header -->
      <header class="jenne-main-header">
        <!-- Tabs -->
        <nav class="jenne-nav-tabs">
          {{#each tabs}}
            <button class="jenne-tab {{#if active}}active{{/if}}" data-action="selectTab" data-tab-name="{{name}}">
              <i class="fas {{icon}}"></i> {{label}}
            </button>
          {{/each}}
        </nav>

        <!-- Search, Status, Sort and Selection controls -->
        <div class="jenne-search-row">
          <div class="jenne-search-container">
            <i class="fas fa-search" style="position: absolute; left: 12px; top: 12px; color: #a4b0be;"></i>
            <input type="text" class="jenne-search-input" placeholder="Search assets globally by name or category..." value="{{searchQuery}}">
          </div>

          <!-- Status Filter Selector -->
          <div class="jenne-status-container" style="display: flex; align-items: center; gap: 6px;">
            <label for="jenne-status-filter-select" style="font-size: 11px; color: var(--text-muted); white-space: nowrap; font-family: 'Cinzel', serif;">
              <i class="fas fa-filter"></i> Status:
            </label>
            <select class="jenne-status-select" id="jenne-status-filter-select" style="background: var(--bg-tertiary); color: var(--text-main); border: 1px solid var(--border-color); border-radius: 4px; padding: 6px 10px; font-size: 12px; height: 36px;">
              {{#each statusOptions}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </div>

          <!-- Sort Selector -->
          <div class="jenne-sort-container" style="display: flex; align-items: center; gap: 6px;">
            <label for="jenne-sort-select" style="font-size: 11px; color: var(--text-muted); white-space: nowrap; font-family: 'Cinzel', serif;">
              <i class="fas fa-arrow-down-short-wide"></i> Sort:
            </label>
            <select class="jenne-sort-select" id="jenne-sort-select" style="background: var(--bg-tertiary); color: var(--text-main); border: 1px solid var(--border-color); border-radius: 4px; padding: 6px 10px; font-size: 12px; height: 36px;">
              {{#each sortOptions}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </div>

          <button class="jenne-btn btn-secondary" data-action="toggleSelectAll">
            <i class="fas fa-check-double"></i> Select All
          </button>
        </div>

        <!-- Dynamic Tag Filters Bar -->
        <div class="jenne-dynamic-tags-bar">
          <div class="active-tags-container">
            <span class="filter-label"><i class="fas fa-tags"></i> Active Tags:</span>
            
            {{#if activeTagsList.length}}
              <div class="active-tags-chips">
                {{#each activeTagsList}}
                  <span class="active-tag-chip">
                    <span class="tag-text">{{name}}</span>
                    <button type="button" class="btn-remove-tag" data-action="removeTag" data-tag="{{name}}" title="Remove tag">&times;</button>
                  </span>
                {{/each}}
                
                <button type="button" class="btn-clear-all-tags" data-action="clearAllTags" title="Clear all active tags">
                  Clear All
                </button>
              </div>
            {{else}}
              <span class="no-tags-hint">No active tag filters.</span>
            {{/if}}
          </div>

          <!-- Add Tag Filter Controls -->
          <div class="add-tag-control">
            <!-- Dropdown of Discovered Catalog Tags -->
            <select class="jenne-add-tag-select" id="jenne-add-tag-dropdown">
              <option value="">+ Choose Tag...</option>
              {{#each availableTags}}
                <option value="{{this}}">{{this}}</option>
              {{/each}}
            </select>

            <!-- Custom Tag Type-in with Enter key or Add button -->
            <div class="custom-tag-input-group">
              <input type="text" class="jenne-custom-tag-input" id="jenne-custom-tag-input" placeholder="Type tag..." list="jenne-tag-datalist">
              <datalist id="jenne-tag-datalist">
                {{#each availableTags}}
                  <option value="{{this}}">
                {{/each}}
              </datalist>
              <button type="button" class="jenne-btn-add-tag" data-action="addCustomTag" title="Add custom tag filter">
                <i class="fas fa-plus"></i> Add
              </button>
            </div>
          </div>
        </div>
      </header>

      <!-- Asset Grid -->
      <section class="jenne-grid-container">
        {{#if assets.length}}
          <div class="jenne-asset-grid" style="grid-template-columns: repeat({{assetsPerRow}}, minmax(0, 1fr));">
            {{#each assets}}
              {{#if isBeneosActor}}
                <div class="jenne-beneos-actor-card draggable {{#if selected}}selected{{/if}} {{#if isInstalled}}installed{{/if}}"
                     data-asset-id="{{id}}"
                     data-token-key="{{key}}"
                     data-drag-mode="{{dragMode}}"
                     data-source="{{source}}"
                     data-asset-type="actor"
                     data-action="toggleSelect"
                     draggable="true">
                     
                  <div class="beneos-actor-media">
                    <img src="{{cover_image}}" alt="{{name}}" loading="lazy" onerror="this.src='icons/svg/mystery-man.svg';">
                    
                    {{#if isUpdate}}
                      <span class="beneos-card-badge badge-update">UPDATE</span>
                    {{else if isNew}}
                      <span class="beneos-card-badge badge-new">NEW</span>
                    {{/if}}

                    {{#if cr}}
                      <span class="beneos-card-badge badge-cr">CR {{cr}}</span>
                    {{/if}}

                    <button class="card-preview-btn" data-action="openPreview" data-asset-id="{{id}}" title="Preview Creature">
                      <i class="fas fa-search-plus"></i>
                    </button>
                  </div>

                  <div class="beneos-actor-info">
                    <div class="beneos-actor-header">
                      <span class="beneos-actor-name" title="{{name}}">{{name}}</span>
                    </div>

                    <div class="beneos-actor-meta">
                      <span class="beneos-meta-tag" title="Creature Type"><i class="fa-solid fa-dragon"></i> {{creatureType}}</span>
                      {{#if biome}}
                        <span class="beneos-meta-tag" title="Biome"><i class="fa-solid fa-tree"></i> {{biome}}</span>
                      {{/if}}
                      {{#if movement}}
                        <span class="beneos-meta-tag" title="Movement"><i class="fa-solid fa-person-running"></i> {{movement}}</span>
                      {{/if}}
                    </div>

                    <div class="beneos-actor-actions">
                      {{#if isInstalled}}
                        <span class="beneos-status-pill pill-installed" title="Installed in World / Compendium">
                          <i class="fa-solid fa-circle-check"></i> Installed
                        </span>
                        {{#if isUpdate}}
                          <button class="beneos-btn-action btn-update" data-action="installBeneosActor" data-key="{{key}}" title="Update to latest version">
                            <i class="fa-solid fa-rotate"></i> Update
                          </button>
                        {{/if}}
                      {{else if isOwned}}
                        <button class="beneos-btn-action btn-install" data-action="installBeneosActor" data-key="{{key}}" title="Download and install creature">
                          <i class="fa-solid fa-cloud-arrow-down"></i> Install
                        </button>
                      {{else}}
                        <span class="beneos-status-pill pill-locked" title="Locked (Patreon subscription required)">
                          <i class="fa-solid fa-lock"></i> Locked
                        </span>
                      {{/if}}

                      <button class="beneos-btn-action btn-open" data-action="openBeneosActor" data-key="{{key}}" title="Open Actor Sheet / Codex / Details">
                        <i class="fa-solid fa-up-right-from-square"></i> Open
                      </button>
                    </div>
                  </div>
                </div>
              {{else}}
                <!-- Standard File / Compendium Asset Card -->
                <div class="jenne-asset-card draggable {{#if selected}}selected{{/if}} {{#if imported}}imported{{/if}}" 
                     data-asset-id="{{id}}" 
                     data-relative-path="{{relativePath}}"
                     data-filename="{{filename}}"
                     data-asset-type="{{type}}"
                     data-is-compendium="{{isCompendium}}"
                     data-uuid="{{uuid}}"
                     data-document-name="{{documentName}}"
                     data-action="toggleSelect">
                     
                  <div class="card-media">
                    <!-- Preview Eye Button Overlay (No stopPropagation inline to allow ApplicationV2 bubbling) -->
                    <button class="card-preview-btn" data-action="openPreview" data-asset-id="{{id}}" title="Preview Asset">
                      <i class="fas fa-search-plus"></i>
                    </button>

                    {{#if (eq type 'image')}}
                      <img src="{{relativePath}}" alt="{{filename}}" loading="lazy">
                    {{else if (eq type 'video')}}
                      <video src="{{relativePath}}" autoplay muted loop playsinline></video>
                    {{else}}
                      <div class="media-placeholder">
                        <i class="fas {{iconClass}}"></i>
                      </div>
                    {{/if}}
                    
                    {{#if imported}}
                      <div class="imported-overlay" data-action="openDocument" data-document-uuid="{{importedDocumentId}}" title="Imported! Click to view sheet.">
                        <i class="fas fa-check-circle"></i>
                      </div>
                    {{/if}}
                  </div>
                  
                  <div class="card-info">
                    <span class="filename" title="{{filename}}">{{filename}}</span>
                  </div>
                </div>
              {{/if}}
            {{/each}}
          </div>
        {{else}}
          <div class="jenne-empty">
            <i class="fas fa-folder-open"></i>
            <p>No assets found matching the criteria.</p>
          </div>
        {{/if}}
      </section>
    </main>
  {{/if}}

  <!-- Sleek Lightbox Preview Modal -->
  {{#if previewAsset}}
    <div class="jenne-preview-modal" data-action="closePreview">
      <div class="preview-modal-content" onclick="event.stopPropagation()">
        <button class="preview-close-btn" data-action="closePreview" title="Close Preview">&times;</button>
        
        {{#if (eq previewAsset.type 'image')}}
          <img src="{{previewAsset.relativePath}}" alt="{{previewAsset.filename}}">
        {{else if (eq previewAsset.type 'video')}}
          <video src="{{previewAsset.relativePath}}" autoplay loop controls></video>
        {{else if (eq previewAsset.type 'audio')}}
          <div class="audio-preview-card">
            <i class="fas fa-music audio-preview-icon"></i>
            <span class="audio-filename">{{previewAsset.filename}}</span>
            
            <div class="audio-controls">
              <button class="audio-btn play-btn" data-action="playAudio" data-path="{{previewAsset.relativePath}}">
                <i class="fas fa-play"></i> PLAY
              </button>
              <button class="audio-btn stop-btn" data-action="stopAudio">
                <i class="fas fa-stop"></i> STOP
              </button>
              <div class="volume-control">
                <i class="fas fa-volume-up"></i>
                <input type="range" class="volume-slider" min="0" max="1" step="0.05" value="0.5">
              </div>
            </div>
          </div>
        {{/if}}
        
        <div class="preview-details">
          <span class="preview-filename">{{previewAsset.filename}}</span>
          <span class="preview-path">{{previewAsset.relativePath}}</span>
        </div>
      </div>
    </div>
  {{/if}}
</div>
